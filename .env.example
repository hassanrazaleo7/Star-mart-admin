# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
AUTH_SECRET=                      # openssl rand -base64 48   (minimum 32 characters)
AUTH_TRUST_HOST=true
# AUTH_URL=https://admin.example.com   # set in production (the canonical origin)
PASSWORD_HIBP_CHECK=false         # true = reject passwords found in the Have I Been Pwned corpus (k-anonymity lookup)

# Only read by `npm run seed:admin`
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# Only read by `npm run db:reset` (must equal the database name in DATABASE_URL)
DB_RESET_CONFIRM=

# Integrations (optional; features show "not configured" until set)
# Product images need a Vercel Blob store created with PUBLIC access (the access mode cannot be changed later).
BLOB_STORE_ID=                    # Vercel Blob store ID (OIDC uploads)
BLOB_WEBHOOK_PUBLIC_KEY=          # Vercel Blob webhook public key (PEM or base64 DER)
BLOB_READ_WRITE_TOKEN=            # Required for local Blob uploads; Vercel deployments may use OIDC instead
BREVO_API_KEY=                    # Brevo transactional email API key
BREVO_SENDER_EMAIL=               # verified sender address in Brevo
BREVO_SENDER_NAME=Star Mart
BREVO_DRY_RUN=true                # true = render + log emails instead of sending (use until a Brevo key is set)
STOREFRONT_API_KEY=               # enables the read-only storefront API (/api/public/*); clients send it as x-api-key. openssl rand -hex 32
STOREFRONT_ORIGINS=               # optional, comma-separated browser origins for CORS, e.g. https://shop.example.com
CRON_SECRET=                      # protects GET/POST /api/jobs/email (x-cron-secret header or Authorization: Bearer); Vercel cron sends it automatically
